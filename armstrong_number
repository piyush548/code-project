class Solution {
public:
    bool isArmstrong(int n) {
        int temp=n;
        int count=0;
        int sum=0;
        while(n!=0){
            count++;
            n=n/10;

        }
        int digits = count;
        n=temp;
        while(n!=0){
            int digit = n%10;
            sum=sum+pow(digit,digits);
            n=n/10; 
        }
        if(sum==temp) return true;
        else return false;

    }
};
