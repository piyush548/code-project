class Solution {
public:
    vector<int> intersectionArray(vector<int>& nums1, vector<int>& nums2) {
        int a = nums1.size();
        int b = nums2.size();
        int i=0;
        int j=0;
        vector<int> arr;
        while(i<a && j<b){
            if(nums1[i]==nums2[j]){
                arr.push_back(nums1[i]);
                i++;
                j++;
            }
            else if(nums1[i]<nums2[j]){
                i++;
            }
            else{
                j++;
            }
        }
        return arr;
    }
};
// nums1 = [1, 2, 3, 4, 5]
// // nums2 = [2, 4, 6]
// Let's dry run:
// i	j	nums1[i]	nums2[j]	Action
// 0	0	1	2	1 < 2, increment i
// 1	0	2	2	Equal, store 2, increment both
// 2	1	3	4	3 < 4, increment i
// 3	1	4	4	Equal, store 4, increment both
// 4	2	5	6	5 < 6, increment i

