class Solution {
public:
    void rotateArray(vector<int>& nums, int k) {
        int n = nums.size();
        k = k%n; // to avoid extra rotation
        for(int i=0;i<k;i++){
            int temp = nums[0];
            for(int j=0;j<n-1;j++){
                nums[j]=nums[j+1];

            }
              nums[n-1] = temp;
        }
    }
};
