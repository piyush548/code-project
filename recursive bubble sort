class Solution {
public:
    void bubble(vector<int>& nums, int n, int i) {
        if(i == n-1) return;

        if(nums[i] > nums[i+1]) {
            swap(nums[i], nums[i+1]);
        }

        bubble(nums, n, i+1);
    }

    void sort(vector<int>& nums, int n) {
        if(n == 1) return;

        bubble(nums, n, 0);

        sort(nums, n-1);
    }

    vector<int> bubbleSort(vector<int>& nums) {
        int n = nums.size();

        sort(nums, n);

        return nums;
    }
};
