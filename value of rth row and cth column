class Solution {
public:
    int pascalTriangleI(int r, int c) {
        int ans = 1;
        for(int i=0;i<c-1;i++){
            ans = ans * (r-1-i)/ (i+1);
        }
        return ans;
    }
};

// Because we need to calculate \(4C2\), which requires multiplying by two factors:
// - First iteration: multiply by 4 and divide by 1.
// - Second iteration: multiply by 3 and divide by 2.
